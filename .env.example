# Copy to .env. Used by docker compose (variable substitution) and by local
# processes started outside compose. Never commit .env.

# Host ports (defaults avoid clashing with a local Postgres/Redis)
AGENTEVAL_PG_HOST_PORT=55432
AGENTEVAL_REDIS_HOST_PORT=56379
AGENTEVAL_API_HOST_PORT=8000

# Local (non-compose) processes connect through the host ports above.
AGENTEVAL_DATABASE_URL=postgresql+asyncpg://agenteval:agenteval@localhost:55432/agenteval
AGENTEVAL_REDIS_URL=redis://localhost:56379/0

# Logging (JSON lines by default; set false for human-readable output).
AGENTEVAL_LOG_LEVEL=INFO
AGENTEVAL_LOG_JSON=true

# Queue: the runs stream and the consumer group (the evaluation stream is below).
AGENTEVAL_DISPATCH_STREAM=runs.dispatch
AGENTEVAL_CONSUMER_GROUP=workers

# Browser origins the API answers CORS for (the dashboard): a JSON list, GET and POST only.
AGENTEVAL_CORS_ORIGINS=["http://localhost:3000"]

# Sandbox: JSON list of images tasks may use, output cap per stream, the
# /workspace tmpfs size and the pids limit of every sandbox container.
AGENTEVAL_IMAGE_ALLOWLIST=["agenteval-sandbox:py312"]
AGENTEVAL_MAX_OUTPUT_BYTES=65536
AGENTEVAL_WORKSPACE_TMPFS_MB=64
AGENTEVAL_PIDS_LIMIT=128

# Worker. WORKER_ID is generated per process when unset (keep it unset: a
# restarted worker must get a new identity). BLOCK_MS is the XREADGROUP block.
# At DRAIN_TIMEOUT_S - CANCEL_GRACE_S in-flight agent runs are cancelled
# (worker_shutdown) so they can record and persist before the drain ends.
AGENTEVAL_WORKER_CONCURRENCY=2
# AGENTEVAL_WORKER_ID=
AGENTEVAL_WORKER_BLOCK_MS=5000
AGENTEVAL_WORKER_DRAIN_TIMEOUT_S=330
AGENTEVAL_WORKER_CANCEL_GRACE_S=20

# Real model calls (opt-in; costs money). Off by default: agent versions use
# the scripted fake provider. The key is passed to the worker only.
AGENTEVAL_ENABLE_ANTHROPIC_PROVIDER=false
ANTHROPIC_API_KEY=
# The scripted fake provider (offline, free) is what dev, CI and the tests use.
AGENTEVAL_ENABLE_FAKE_PROVIDER=true

# Global caps on agent-version limits. Versions above a cap are rejected (422),
# never clamped.
AGENTEVAL_AGENT_MAX_STEPS_CAP=100
AGENTEVAL_AGENT_MAX_TOTAL_TOKENS_CAP=2000000
AGENTEVAL_AGENT_MAX_COST_USD_CAP=5.00

# Leases (ADR-008 D, ADR-009). Startup refuses a combination that can't keep a
# healthy lease: heartbeat < ttl - margin, margin >= 2 x reconcile interval,
# liveness timeout < ttl - margin. (docker-compose.e2e.yml overrides these
# for the e2e suite only.)
AGENTEVAL_LEASE_TTL_S=30
AGENTEVAL_HEARTBEAT_S=10
AGENTEVAL_SELF_FENCE_MARGIN_S=10
AGENTEVAL_RECONCILE_INTERVAL_S=5
AGENTEVAL_WORKER_LIVENESS_TIMEOUT_S=15

# Reconciler: redispatch threshold, orphan sweep interval, stream trim length.
AGENTEVAL_REDISPATCH_AFTER_S=60
AGENTEVAL_ORPHAN_SWEEP_INTERVAL_S=300
AGENTEVAL_STREAM_MAXLEN=100000
# Evaluations are dispatched on their own stream (same consumer group).
AGENTEVAL_EVALUATION_STREAM=evaluations.dispatch

# Execution budget: the max_attempts (1..10) a run is pinned with when the
# request doesn't give one (POST /runs, and a batch's run_max_attempts).
AGENTEVAL_RUN_MAX_ATTEMPTS=3

# Evaluation reliability: grading attempts pinned on an ad hoc run's evaluation
# row (1..10; a batch uses its own eval_max_attempts), and how long a FINISHED
# attempt may lack an evaluation row before the reconciler records one.
AGENTEVAL_EVAL_MAX_ATTEMPTS=3
AGENTEVAL_A1_GRACE_S=60

# Artifacts (ADR-008). Snapshot files live in AGENTEVAL_ARTIFACT_DIR (a named
# volume in compose). The sweep grace must exceed save deadline + insert
# timeout; startup refuses otherwise.
AGENTEVAL_ARTIFACT_DIR=/var/lib/agenteval/artifacts
AGENTEVAL_ARTIFACT_INSERT_TIMEOUT_S=10
AGENTEVAL_ARTIFACT_SAVE_DEADLINE_S=15
AGENTEVAL_ARTIFACT_SWEEP_GRACE_S=120
