# Production settings for docker-compose.prod.yml (ADR-012 F).
#
# Copy this file to a location OUTSIDE the repository (for example /etc/agenteval/prod.env),
# `chmod 600` it, and pass it to every compose command:
#
#   docker compose --env-file /etc/agenteval/prod.env \
#     -f docker-compose.yml -f docker-compose.prod.yml <command>
#
# Every value below is a placeholder. Generate real secrets, for example:
#   openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
# Never commit the real file.

# --- Required ---------------------------------------------------------------------------------

# Public hostname. Its DNS record must point at this host and ports 80/443 must be reachable:
# Caddy obtains the TLS certificate for it. The dashboard is served at https://<domain>/ and the
# API at https://<domain>/api/v1/.
AGENTEVAL_DOMAIN=agenteval.example.com

# Passwords for the internal Postgres and Redis (neither is published to the network).
# Use letters and digits only: they are embedded in connection URLs.
POSTGRES_PASSWORD=CHANGE_ME_generate_a_long_random_password
REDIS_PASSWORD=CHANGE_ME_generate_a_different_long_random_password

# --- Images -----------------------------------------------------------------------------------

# Where the images come from and which release to run. Pin an exact tag (v1.0.0), not `latest`.
# Build them on the host instead with `docker compose ... build` (the tags above are then local).
AGENTEVAL_IMAGE_PREFIX=ghcr.io/your-github-user/agenteval
AGENTEVAL_VERSION=v0.0.0

# --- Optional ---------------------------------------------------------------------------------

# uvicorn processes in the API container. Keep 1 unless you accept that /metrics then reports one
# arbitrary process per scrape (docs/deployment.md, "Sizing").
AGENTEVAL_API_WORKERS=1

# Concurrent runs per worker container, and the worker log level.
AGENTEVAL_WORKER_CONCURRENCY=2
AGENTEVAL_LOG_LEVEL=INFO

# Authentication (ADR-012 A/B). Keep it on in production; create the first key after migrating
# (docs/deployment.md, "Bootstrap keys").
AGENTEVAL_AUTH_ENABLED=true

# Real model calls (opt-in; costs money). Passed to the worker only, never to the API or to a
# sandbox. Leave the key empty to use only the scripted fake provider.
AGENTEVAL_ENABLE_ANTHROPIC_PROVIDER=false
ANTHROPIC_API_KEY=
